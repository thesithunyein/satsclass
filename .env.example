# Copy to .env before `docker compose up`. Regtest only: these are not real funds.
BTC_RPC_USER=satsclass
BTC_RPC_PASS=change-me-to-a-long-random-string
# Seconds between mined blocks on the classroom chain
BLOCK_INTERVAL=10
# Amount the class faucet sends per learner claim (BTC)
FAUCET_AMOUNT_BTC=0.001

# ---------------------------------------------------------------------------
# Vercel / serverless deployment (set these in the Vercel project, not in .env)
# ---------------------------------------------------------------------------
# CHAIN_BACKEND=esplora
# BTC_NETWORK=signet
# ESPLORA_URL=https://mutinynet.com/api
# FAUCET_AMOUNT_BTC=0.0001
# FAUCET_MNEMONIC="12 words from `npm run faucet:new`"   (secret; test coins only)
# UPSTASH_REDIS_REST_URL=...    (or KV_REST_API_URL from the Vercel Upstash integration)
# UPSTASH_REDIS_REST_TOKEN=...  (or KV_REST_API_TOKEN)
