# Copy to .env before `docker compose up`. Regtest only: these are not real funds.
BTC_RPC_USER=satsclass
BTC_RPC_PASS=change-me-to-a-long-random-string
# Seconds between mined blocks on the classroom chain
BLOCK_INTERVAL=10
# Amount the class faucet sends per learner claim (BTC)
FAUCET_AMOUNT_BTC=0.001
